        "pin": {
          "anyOf": [
            {
              "enum": [
                "VERIFIED",
                "MISMATCH",
                "STALE",
                "MISSING_FILE",
                "NOT_LISTED",
                "NOT_PINNED"
              ],
              "type": "string"
            },
            {
              "enum": [
                "NOT_APPLICABLE",
                "UNAVAILABLE"
              ],
              "type": "string"
            }
          ],
          "title": "Pin"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "enum": [
                "NOT_APPLICABLE",
                "UNAVAILABLE"
              ],
              "type": "string"
            }
          ],
          "title": "Sha256"
