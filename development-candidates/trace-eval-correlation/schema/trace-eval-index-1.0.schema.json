        "source_manifest": {
          "anyOf": [
            {
              "enum": [
                "VERIFIED",
                "MISMATCH",
                "STALE",
                "MISSING_FILE",
                "NOT_LISTED",
                "NOT_PINNED"
              ],
              "type": "string"
            },
            {
              "enum": [
                "NOT_APPLICABLE",
                "UNAVAILABLE"
              ],
              "type": "string"
            }
          ],
          "title": "Source Manifest"
        }
      },
      "required": [
        "kind",
        "ref",
        "sha256",
        "source_manifest",
        "pin"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
