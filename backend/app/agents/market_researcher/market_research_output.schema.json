{
  "$defs": {
    "DataQuality": {
      "properties": {
        "failed_sources": {
          "items": {
            "type": "string"
          },
          "title": "Failed Sources",
          "type": "array"
        },
        "stale_series": {
          "items": {
            "type": "string"
          },
          "title": "Stale Series",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "Driver": {
      "properties": {
        "indicator": {
          "title": "Indicator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "indicator",
        "direction",
        "contribution"
      ],
      "title": "Driver",
      "type": "object"
    },
    "Event": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "notable",
            "major"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "description": "Indicator / symbol ids backing this event.",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity",
        "description"
      ],
      "title": "Event",
      "type": "object"
    },
    "Indicator": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "changes": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Change over each window, in the value's own unit (pp for % values; % for prices).",
          "title": "Changes",
          "type": "object"
        },
        "percentile_10y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Percentile 10Y"
        },
        "zscore_10y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zscore 10Y"
        },
        "signal": {
          "default": "neutral",
          "enum": [
            "bullish_growth",
            "bearish_growth",
            "inflationary",
            "disinflationary",
            "tightening",
            "easing",
            "neutral"
          ],
          "title": "Signal",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "value",
        "unit",
        "observation_date",
        "source",
        "source_url"
      ],
      "title": "Indicator",
      "type": "object"
    },
    "MarketResearchRequest": {
      "properties": {
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The main agent's question or focus, if any.",
          "title": "Query"
        },
        "region": {
          "default": "US",
          "description": "Only 'US' is supported in v1.",
          "enum": [
            "US",
            "EU",
            "SG",
            "GLOBAL"
          ],
          "title": "Region",
          "type": "string"
        },
        "focus": {
          "description": "Extra focus terms, e.g. [\"rates\", \"energy\"].",
          "items": {
            "type": "string"
          },
          "title": "Focus",
          "type": "array"
        },
        "lookback_days_news": {
          "default": 3,
          "maximum": 14,
          "minimum": 1,
          "title": "Lookback Days News",
          "type": "integer"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = now; set for replays/backtests.",
          "title": "As Of"
        },
        "include_narrative": {
          "default": false,
          "description": "Also produce an LLM narrative (validated against the data).",
          "title": "Include Narrative",
          "type": "boolean"
        }
      },
      "title": "MarketResearchRequest",
      "type": "object"
    },
    "NewsItem": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "sentiment": {
          "default": "neutral",
          "enum": [
            "risk_on",
            "risk_off",
            "neutral"
          ],
          "title": "Sentiment",
          "type": "string"
        },
        "market_impact": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Market Impact",
          "type": "string"
        }
      },
      "required": [
        "title",
        "source",
        "url",
        "summary"
      ],
      "title": "NewsItem",
      "type": "object"
    },
    "Regime": {
      "properties": {
        "phase": {
          "anyOf": [
            {
              "enum": [
                "early_expansion",
                "late_expansion",
                "recession",
                "late_recession"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "recession_prob_12m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NY Fed yield-curve probit model estimate, 0-1.",
          "title": "Recession Prob 12M"
        },
        "composites": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "G (growth level), M (momentum), I (inflation), P (policy/financial stance).",
          "title": "Composites",
          "type": "object"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "conflicting_signals": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Signals",
          "type": "array"
        },
        "previous_phase": {
          "anyOf": [
            {
              "enum": [
                "early_expansion",
                "late_expansion",
                "recession",
                "late_recession"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Phase"
        },
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        }
      },
      "title": "Regime",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "agent": {
      "const": "market_researcher",
      "default": "market_researcher",
      "title": "Agent",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/MarketResearchRequest"
    },
    "regime": {
      "$ref": "#/$defs/Regime"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Indicators",
      "type": "array"
    },
    "market_snapshot": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Market Snapshot",
      "type": "array"
    },
    "news": {
      "items": {
        "$ref": "#/$defs/NewsItem"
      },
      "title": "News",
      "type": "array"
    },
    "key_themes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Themes"
    },
    "risks": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risks"
    },
    "implications": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Descriptive, not advice.",
      "title": "Implications"
    },
    "narrative": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Narrative"
    },
    "data_quality": {
      "$ref": "#/$defs/DataQuality"
    }
  },
  "required": [
    "run_id",
    "generated_at",
    "as_of",
    "region",
    "request",
    "regime"
  ],
  "title": "MarketResearchOutput",
  "type": "object"
}
