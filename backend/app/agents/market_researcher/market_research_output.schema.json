{
  "$defs": {
    "CitedSource": {
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The article text the model was shown.",
          "title": "Snippet"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the search returned this article.",
          "title": "Retrieved At"
        }
      },
      "required": [
        "url",
        "title",
        "source"
      ],
      "title": "CitedSource",
      "type": "object"
    },
    "DataQuality": {
      "properties": {
        "failed_sources": {
          "items": {
            "type": "string"
          },
          "title": "Failed Sources",
          "type": "array"
        },
        "stale_series": {
          "items": {
            "type": "string"
          },
          "title": "Stale Series",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "Driver": {
      "properties": {
        "indicator": {
          "title": "Indicator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "contribution": {
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "indicator",
        "direction",
        "contribution"
      ],
      "title": "Driver",
      "type": "object"
    },
    "Event": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "notable",
            "major"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "description": "Indicator / symbol ids backing this event.",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "severity",
        "description"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventExplanation": {
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "explained",
            "insufficient_evidence",
            "unavailable",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "<= 70 words, own words; numbers validated.",
          "title": "Explanation"
        },
        "likely_drivers": {
          "description": "1-3 short phrases.",
          "items": {
            "type": "string"
          },
          "title": "Likely Drivers",
          "type": "array"
        },
        "decomposition": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Code-derived facts (decompositions.py).",
          "title": "Decomposition"
        },
        "cited_urls": {
          "items": {
            "type": "string"
          },
          "title": "Cited Urls",
          "type": "array"
        },
        "cited_sources": {
          "description": "Title/source/date of each cited article (same order as cited_urls).",
          "items": {
            "$ref": "#/$defs/CitedSource"
          },
          "title": "Cited Sources",
          "type": "array"
        },
        "cited_indicators": {
          "items": {
            "type": "string"
          },
          "title": "Cited Indicators",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "queries_run": {
          "description": "Searches actually run for this event.",
          "items": {
            "type": "string"
          },
          "title": "Queries Run",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "status"
      ],
      "title": "EventExplanation",
      "type": "object"
    },
    "Indicator": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "changes": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Change over each window, in the value's own unit (pp for % values; % for prices).",
          "title": "Changes",
          "type": "object"
        },
        "percentile_10y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-100, vs the last 10 years - or less; see stats_window_years.",
          "title": "Percentile 10Y"
        },
        "zscore_10y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Std devs from the trailing mean over stats_window_years.",
          "title": "Zscore 10Y"
        },
        "stats_window_years": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Years of history behind percentile_10y/zscore_10y: 10 unless the source's history is shorter.",
          "title": "Stats Window Years"
        },
        "signal": {
          "default": "neutral",
          "enum": [
            "bullish_growth",
            "bearish_growth",
            "inflationary",
            "disinflationary",
            "tightening",
            "easing",
            "neutral"
          ],
          "title": "Signal",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "value",
        "unit",
        "observation_date",
        "source",
        "source_url"
      ],
      "title": "Indicator",
      "type": "object"
    },
    "LlmAttempt": {
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "error",
            "timeout"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "integer"
        },
        "problems": {
          "description": "Why it was rejected or failed, if it was.",
          "items": {
            "type": "string"
          },
          "title": "Problems",
          "type": "array"
        },
        "rejected_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The text that was rejected, kept for review.",
          "title": "Rejected Text"
        }
      },
      "required": [
        "stage",
        "attempt",
        "outcome",
        "latency_ms"
      ],
      "title": "LlmAttempt",
      "type": "object"
    },
    "MarketResearchRequest": {
      "properties": {
        "query": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The main agent's question or focus, if any.",
          "title": "Query"
        },
        "region": {
          "default": "US",
          "description": "Only 'US' is supported in v1.",
          "enum": [
            "US",
            "EU",
            "SG",
            "GLOBAL"
          ],
          "title": "Region",
          "type": "string"
        },
        "focus": {
          "description": "Extra focus terms, e.g. [\"rates\", \"energy\"].",
          "items": {
            "maxLength": 80,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Focus",
          "type": "array"
        },
        "lookback_days_news": {
          "default": 3,
          "maximum": 14,
          "minimum": 1,
          "title": "Lookback Days News",
          "type": "integer"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = now; set for replays/backtests.",
          "title": "As Of"
        },
        "include_narrative": {
          "default": false,
          "description": "Also produce an LLM narrative (validated against the data).",
          "title": "Include Narrative",
          "type": "boolean"
        },
        "planning": {
          "default": "auto",
          "description": "'auto': an LLM picks extra series/symbols/news queries from curated catalogs when there is a query or focus. 'off': fixed core set only (focus terms become news queries).",
          "enum": [
            "auto",
            "off"
          ],
          "title": "Planning",
          "type": "string"
        },
        "explain_events": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Investigate notable events (targeted news + decompositions + cited explanation). None = on for live runs, off for a past as_of.",
          "title": "Explain Events"
        }
      },
      "title": "MarketResearchRequest",
      "type": "object"
    },
    "NewsItem": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "sentiment": {
          "default": "neutral",
          "enum": [
            "risk_on",
            "risk_off",
            "neutral"
          ],
          "title": "Sentiment",
          "type": "string"
        },
        "market_impact": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Market Impact",
          "type": "string"
        }
      },
      "required": [
        "title",
        "source",
        "url",
        "summary"
      ],
      "title": "NewsItem",
      "type": "object"
    },
    "PlanRecord": {
      "properties": {
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueryPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_source": {
          "enum": [
            "llm",
            "heuristic",
            "skipped",
            "failed"
          ],
          "title": "Plan Source",
          "type": "string"
        },
        "dropped": {
          "description": "Ids/queries rejected by validation, with the reason.",
          "items": {
            "type": "string"
          },
          "title": "Dropped",
          "type": "array"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "plan_source"
      ],
      "title": "PlanRecord",
      "type": "object"
    },
    "QualityReport": {
      "description": "Final self-check of the run (quality.py). Consumers should read `status`\nbefore using the output: `unusable` = do not quote the regime or indicators.",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "unusable"
          ],
          "title": "Status",
          "type": "string"
        },
        "checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "consistency, completeness, freshness, sources, advice_language: True = passed.",
          "title": "Checks",
          "type": "object"
        },
        "issues": {
          "description": "Why a check failed, one line each.",
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "QualityReport",
      "type": "object"
    },
    "QueryPlan": {
      "properties": {
        "intent": {
          "description": "One sentence: what the caller wants to know.",
          "title": "Intent",
          "type": "string"
        },
        "areas": {
          "items": {
            "enum": [
              "rates",
              "inflation",
              "labor",
              "growth",
              "housing",
              "credit",
              "energy",
              "equities",
              "fx",
              "global",
              "fed",
              "consumer"
            ],
            "type": "string"
          },
          "title": "Areas",
          "type": "array"
        },
        "extra_series": {
          "description": "Catalog FRED ids only.",
          "items": {
            "type": "string"
          },
          "title": "Extra Series",
          "type": "array"
        },
        "extra_symbols": {
          "description": "Catalog symbols only.",
          "items": {
            "type": "string"
          },
          "title": "Extra Symbols",
          "type": "array"
        },
        "news_queries": {
          "description": "Each 3-12 words; no operators beyond quotes/OR.",
          "items": {
            "type": "string"
          },
          "title": "News Queries",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "description": "<= 60 words: why these choices.",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "intent"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "Regime": {
      "properties": {
        "phase": {
          "anyOf": [
            {
              "enum": [
                "early_expansion",
                "late_expansion",
                "recession",
                "late_recession"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Per phase. The recession + late_recession share equals in_recession_prob; the split within each pair comes from the scores.",
          "title": "Probabilities",
          "type": "object"
        },
        "in_recession_prob": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "P(the economy is in recession now) = P(recession) + P(late_recession), calibrated against NBER history when RegimeConfig.calibration is set.",
          "title": "In Recession Prob"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Raw (smoothed) phase scores behind the call; higher = stronger.",
          "title": "Scores",
          "type": "object"
        },
        "confidence": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "recession_prob_12m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NY Fed yield-curve probit model estimate, 0-1.",
          "title": "Recession Prob 12M"
        },
        "composites": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "G (growth level), M (momentum), I (inflation), P (policy/financial stance).",
          "title": "Composites",
          "type": "object"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "conflicting_signals": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Signals",
          "type": "array"
        },
        "previous_phase": {
          "anyOf": [
            {
              "enum": [
                "early_expansion",
                "late_expansion",
                "recession",
                "late_recession"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Phase"
        },
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        }
      },
      "title": "Regime",
      "type": "object"
    },
    "RunOrigin": {
      "description": "Where a run came from. `session_id` identifies a chat session, not a verified person.",
      "properties": {
        "channel": {
          "enum": [
            "chat",
            "http"
          ],
          "title": "Channel",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        }
      },
      "required": [
        "channel"
      ],
      "title": "RunOrigin",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.6",
      "title": "Schema Version",
      "type": "string"
    },
    "agent": {
      "const": "market_researcher",
      "default": "market_researcher",
      "title": "Agent",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/MarketResearchRequest"
    },
    "regime": {
      "$ref": "#/$defs/Regime"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Indicators",
      "type": "array"
    },
    "market_snapshot": {
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Market Snapshot",
      "type": "array"
    },
    "news": {
      "items": {
        "$ref": "#/$defs/NewsItem"
      },
      "title": "News",
      "type": "array"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planned_indicators": {
      "description": "Planner extras from EXTRA_SERIES_CATALOG; never used by regime/events.",
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Planned Indicators",
      "type": "array"
    },
    "planned_market": {
      "description": "Planner extras from EXTRA_SYMBOL_CATALOG; never used by regime/events.",
      "items": {
        "$ref": "#/$defs/Indicator"
      },
      "title": "Planned Market",
      "type": "array"
    },
    "event_explanations": {
      "description": "Linked to `events` by event_id.",
      "items": {
        "$ref": "#/$defs/EventExplanation"
      },
      "title": "Event Explanations",
      "type": "array"
    },
    "key_themes": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Themes"
    },
    "risks": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Risks"
    },
    "implications": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Descriptive, not advice.",
      "title": "Implications"
    },
    "narrative": {
      "anyOf": [
        {
